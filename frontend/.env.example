# ===========================================
# WapiBei Frontend — Environment Variables
# ===========================================

# Backend API URL
# Local development:
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api

# Online backend example (Render / Railway / VPS / etc.):
# NEXT_PUBLIC_API_URL=https://your-backend-domain.com/api

# Web Push public VAPID key (must match backend VAPID_PUBLIC_KEY)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Allowed origins for server actions (comma-separated)
# Example: localhost:3000,192.168.1.100:3000
ALLOWED_ORIGINS=localhost:3000

# Allowed dev origins for Next.js dev server (comma-separated)
# Example: 192.168.1.100,192.168.10.252
ALLOWED_DEV_ORIGINS=

# Public base URL used when sharing product links in WhatsApp messages.
NEXT_PUBLIC_APP_URL=http://localhost:3000
